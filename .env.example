# ── Database ────────────────────────────────────────────────────────────────
# LOCAL DEV (default): SQLite file — keep this in .env for local work.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# PRODUCTION (Vercel + Turso): paste your Turso URL here AND into
# Vercel → Project → Settings → Environment Variables:
# DATABASE_URL="libsql://your-db.turso.io?authToken=your-token"

# ── Admin console (recommended in production) ───────────────────────────────
# Signs the admin session cookies. Any long random string.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# NOTE: Razorpay keys, the booking advance amount and the admin login email +
# password live in the database and are edited from the admin console
# (Settings) — no env vars needed for them.
